# Supabase Project Configuration Example
# Copy this file to .env and configure your local or cloud environment values.

SUPABASE_URL=https://<your-project-id>.supabase.co
SUPABASE_ANON_KEY=<your-publishable-anon-key>
SUPABASE_PUBLISHABLE_KEY=<your-modern-publishable-key>

# NOTE: The Supabase service-role secret key must NEVER be exposed to the browser or public client!
# SUPABASE_SERVICE_ROLE_KEY=<service-role-secret-only-on-secure-backend>
